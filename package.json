{
  "name": "watchdog",
  "version": "1.0.1",
  "description": "All-in-one website auditor: Accessibility, Performance, SEO, Security, Best Practices & PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:ux": "vite --config vite.gallery.config.ts",
    "build": "tsc && vite build && vite build --config vite.content.config.ts",
    "lint": "biome check ./src",
    "fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright install chromium && npm run build && playwright test",
    "all": "npm run fix && npm run typecheck && npm run test && npm run build",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "chrome-extension",
    "wcag"
  ],
  "author": "Hrithik Agarwal",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@changesets/cli": "^2.31.0",
    "@crxjs/vite-plugin": "^2.7.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.10.6",
    "inter-ui": "^4.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.2",
    "axe-core": "^4.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  }
}
